<?xml version="1.0"?>
<ruleset name="Zernyar">
	<description>WordPress Coding Standards for the plugins and the theme.</description>

	<file>plugins/ua-commerce-kit</file>
	<file>plugins/zernyar-demo</file>
	<file>themes/zernyar</file>

	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ua-commerce-kit"/>
				<element value="zernyar-demo"/>
				<element value="zernyar"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>plugins/ua-commerce-kit/src/*</exclude-pattern>
		<exclude-pattern>plugins/ua-commerce-kit/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>plugins/ua-commerce-kit/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>plugins/ua-commerce-kit/tests/*</exclude-pattern>
	</rule>

	<rule ref="Squiz.Commenting">
		<exclude-pattern>plugins/ua-commerce-kit/tests/*</exclude-pattern>
	</rule>

	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>plugins/ua-commerce-kit/tests/*</exclude-pattern>
	</rule>
</ruleset>
