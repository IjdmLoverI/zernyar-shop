msgctxt "Pattern title"
msgid "Catalog with filters"
msgstr "Каталог із фільтрами"

#: patterns/catalog.php:15
msgid "Roast"
msgstr "Обсмаження"

#: patterns/catalog.php:16
msgid "Origin"
msgstr "Країна"

#: patterns/catalog.php:17
msgid "Processing"
msgstr "Обробка"

#: patterns/catalog.php:35
msgid "Clear filters"
msgstr "Скинути фільтри"

#: patterns/catalog.php:47
msgid "Category"
msgstr "Категорія"

#: patterns/catalog.php:75
msgid "Price"
msgstr "Ціна"

#: patterns/checkout-header.php
msgctxt "Pattern title"
msgid "Checkout header"
msgstr "Шапка оформлення"

#: patterns/checkout-header.php:21
msgid "Back to cart"
msgstr "Назад до кошика"

#: patterns/delivery-note.php
msgctxt "Pattern title"
msgid "Delivery and payment note"
msgstr "Примітка про доставку й оплату"

#: patterns/delivery-note.php:14
msgid "Roasted on Tuesday, shipped from Wednesday"
msgstr "Обсмажуємо у вівторок, відправляємо із середи"

#: patterns/delivery-note.php:18
msgid "Nova Poshta branch or parcel locker, 1–3 days"
msgstr "Відділення чи поштомат Нової Пошти, 1–3 дні"

#: patterns/delivery-note.php:22
msgid "Card payment or cash on delivery"
msgstr "Оплата карткою або при отриманні"

#: patterns/featured-products.php
msgctxt "Pattern title"
msgid "Featured coffee"
msgstr "Рекомендована кава"

#: patterns/featured-products.php:20
msgid "All coffee"
msgstr "Уся кава"

#: patterns/footer.php
msgctxt "Pattern title"
msgid "Footer"
msgstr "Футер"

#: patterns/footer.php:22
msgid "A small roastery that roasts specialty coffee every Tuesday and ships it across Ukraine the same week."
msgstr "Невелика обсмажувальня: щовівторка обсмажуємо спешелті-каву й того ж тижня відправляємо по всій Україні."

#: patterns/footer.php:30
msgid "Store"
msgstr "Магазин"

#: patterns/footer.php:40
msgid "Contacts"
msgstr "Контакти"

#: patterns/footer.php:44
msgid "Kyiv, Ukraine"
msgstr "Київ, Україна"

#: patterns/footer.php:44
msgid "Orders are shipped on weekdays"
msgstr "Відправляємо замовлення в будні"

#: patterns/footer.php:54
msgid "A demo store for a portfolio: the roastery is made up, payments run in test mode and no order is shipped."
msgstr "Демо-магазин для портфоліо: обсмажувальня вигадана, оплата тестова, замовлення не відправляються."

#: patterns/hero.php
msgctxt "Pattern title"
msgid "Hero"
msgstr "Головний банер"

#: patterns/hero.php:26
msgid "Single origins and blends for espresso, filter and the cezve. We grind for your brewer and ship by Nova Poshta."
msgstr "Моносорти й суміші для еспресо, фільтра й турки. Мелемо під ваш спосіб і відправляємо Новою Поштою."

#: patterns/hero.php:32
msgid "Choose coffee"
msgstr "Обрати каву"

#: patterns/hero.php:46
msgid "A roaster tips freshly roasted beans into the cooling tray"
msgstr "Обсмажувальник висипає свіже зерно в лоток для охолодження"

#: patterns/not-found.php
msgctxt "Pattern title"
msgid "Page not found"
msgstr "Сторінку не знайдено"

#: patterns/not-found.php:15
msgid "This page is out of stock"
msgstr "Цієї сторінки немає в наявності"

#: patterns/not-found.php:19
msgid "The link is broken or the page was moved. The coffee is still in the catalog."
msgstr "Посилання застаріло або сторінку перенесли. А кава досі в каталозі."

#: patterns/not-found.php:25
msgid "Go to the catalog"
msgstr "До каталогу"

#: patterns/product-card.php
msgctxt "Pattern title"
msgid "Product card"
msgstr "Картка товару"

#: patterns/related-products.php
msgctxt "Pattern title"
msgid "Related coffee"
msgstr "Схожа кава"

#: patterns/related-products.php:15
msgid "You may also like"
msgstr "Вам також може сподобатися"

#: patterns/story.php
msgctxt "Pattern title"
msgid "Roastery story"
msgstr "Про обсмажувальню"

#: patterns/story.php:18
msgid "A handful of freshly roasted beans over the roaster tray"
msgstr "Жменя свіжообсмаженого зерна над лотком ростера"

#: patterns/story.php:26
msgid "About the roastery"
msgstr "Про обсмажувальню"

#: patterns/story.php:30
msgid "Small batches and a roast profile for every lot"
msgstr "Невеликі партії й свій профіль обсмаження для кожного лоту"

#: patterns/story.php:34
msgid "We buy green coffee from importers who know the farms, cup every lot and look for the roast that brings out its own taste. A batch is 12 kg, so nothing sits on a shelf for months."
msgstr "Купуємо зелену каву в імпортерів, які знають ферми, дегустуємо кожен лот і шукаємо обсмаження, що розкриває його власний смак. Партія — 12 кг, тож нічого не лежить на полиці місяцями."

#: patterns/story.php:40
msgid "coffees on the menu"
msgstr "кав у меню"

#: patterns/story.php:44
msgid "roast day a week"
msgstr "день обсмаження на тиждень"

#: patterns/story.php:48
msgid "cupping score of every lot"
msgstr "балів кожного лоту за каппінгом"

