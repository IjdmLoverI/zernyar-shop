#: build/checkout.js:2
#, js-format
msgid "%1$s №%2$s"
msgstr "%1$s №%2$s"

#: build/checkout.js:2
msgid "Start typing the city, then pick a branch, a parcel locker or a pickup point."
msgstr "Почніть вводити місто, потім оберіть відділення, поштомат або пункт."

#: src/WayForPay/Endpoints.php:104
msgid "return from the payment page"
msgstr "повернення зі сторінки оплати"

#: src/WayForPay/Endpoints.php:107
msgid "The payment did not go through. You can try again or choose another payment method."
msgstr "Оплата не пройшла. Спробуйте ще раз або оберіть інший спосіб оплати."

