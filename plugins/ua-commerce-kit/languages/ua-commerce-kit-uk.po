#. Description of the plugin
#: ua-commerce-kit.php
msgid "Nova Poshta delivery, WayForPay payments and Telegram order notifications for WooCommerce."
msgstr "Доставка Новою Поштою, оплата через WayForPay і сповіщення про замовлення в Telegram для WooCommerce."

#. Author of the plugin
#: ua-commerce-kit.php
msgid "Kyrylo Buchynskyi"
msgstr "Кирило Бучинський"

